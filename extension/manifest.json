{
  "manifest_version": 3,
  "name": "Mae Storm Eats Pinterest Importer",
  "version": "0.3.1",
  "description": "Imports the signed-in owner's Pinterest board recipes and reviews into a configured WordPress site.",
  "icons": {
    "32": "icons/mae-storm-eats.svg",
    "48": "icons/mae-storm-eats.svg",
    "64": "icons/mae-storm-eats.svg",
    "96": "icons/mae-storm-eats.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mae-storm-eats-importer@eats.maestorm.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "tabHide"
  ],
  "host_permissions": [
    "https://www.pinterest.com/*",
    "https://*.pinimg.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "connection.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/mae-storm-eats.svg",
      "32": "icons/mae-storm-eats.svg",
      "64": "icons/mae-storm-eats.svg"
    },
    "default_title": "Import Pinterest board",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pinterest.com/*"
      ],
      "js": [
        "collector.js"
      ],
      "run_at": "document_start"
    }
  ]
}
