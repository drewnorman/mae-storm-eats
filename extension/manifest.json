{
  "manifest_version": 3,
  "name": "Mae Storm Pinterest Recipe Importer",
  "version": "1.0.0",
  "description": "Imports the signed-in owner's Pinterest board recipes and reviews into recipes.maestorm.com.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pinterest-importer@recipes.maestorm.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://www.pinterest.com/*",
    "https://*.pinimg.com/*",
    "https://recipes.maestorm.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Import Pinterest board",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pinterest.com/*"],
      "js": ["collector.js"],
      "run_at": "document_idle"
    }
  ]
}
