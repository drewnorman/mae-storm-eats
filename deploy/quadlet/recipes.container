[Unit]
Description=Mae Storm Recipes WordPress
After=recipes-db.service
Requires=recipes-db.service

[Container]
ContainerName=recipes
Image=ghcr.io/drewnorman/mae-storm-recipes:0.1.0
Network=recipes.network
EnvironmentFile=/run/recipes/wordpress.env
Volume=/var/lib/shared/uploads:/var/www/html/wp-content/uploads:Z
Volume=/var/lib/shared/runtime:/run/secrets:ro,Z
PublishPort=127.0.0.1:8080:80
HealthCmd=curl -fsS http://127.0.0.1/wp-login.php
HealthInterval=30s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
