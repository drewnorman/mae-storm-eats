[Unit]
Description=Mae Storm Eats MariaDB
After=network-online.target mae-storm-eats-secrets.service
Requires=mae-storm-eats-secrets.service
RequiresMountsFor=/var/lib/shared
ConditionPathExists=/var/lib/shared/releases/launch-enabled

[Container]
ContainerName=mae-storm-eats-db
Image=docker.io/library/mariadb:11.4.8@sha256:bc474f00629f0123c10f9e1bca193a45d18af15a274cf0656acda64f1086c3b6
Network=mae-storm-eats.network
EnvironmentFile=/var/lib/shared/runtime/wordpress.env
Volume=/var/lib/shared/database:/var/lib/mysql:Z
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=10s
HealthRetries=10

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
