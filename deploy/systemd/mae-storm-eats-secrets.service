[Unit]
Description=Hydrate Mae Storm Eats production secrets
Before=mae-storm-eats-db.service mae-storm-eats.service
RequiresMountsFor=/var/lib/shared

[Service]
Type=oneshot
Environment=MAE_STORM_EATS_SECRET_FILE=/var/lib/shared/runtime/wordpress.env
ExecStart=/opt/mae-storm-eats/bin/hydrate-secrets
RemainAfterExit=yes
