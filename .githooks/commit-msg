#!/usr/bin/env sh
set -eu

if ! command -v corepack >/dev/null 2>&1; then
  echo "corepack is required to lint commit messages." >&2
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "node_modules is missing. Run 'just bootstrap' before committing." >&2
  exit 1
fi

XDG_CACHE_HOME="${RECIPES_CACHE_HOME:-/tmp/recipes-cache}" \
  COREPACK_HOME="${RECIPES_COREPACK_HOME:-/tmp/recipes-corepack}" \
  corepack yarn commitlint --edit "$1"
