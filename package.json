{
  "name": "@mae-storm/eats",
  "version": "0.2.3",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "build": "yarn build:css && yarn build:js",
    "build:css": "tailwindcss -c tailwind.config.js -i themes/mae-storm-eats/assets/src/app.css -o themes/mae-storm-eats/assets/dist/app.css --postcss",
    "build:js": "esbuild themes/mae-storm-eats/assets/src/app.ts --bundle --format=iife --target=es2018 --sourcemap --outfile=themes/mae-storm-eats/assets/dist/app.js",
    "commitlint": "commitlint",
    "dev": "yarn build:css --watch & yarn build:js --watch",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "fluid-tailwind": "^1.0.4",
    "gsap": "^3.12.7",
    "postcss": "^8.5.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  }
}
