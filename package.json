{
  "name": "@mae-storm/eats",
  "version": "0.6.0",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "build": "yarn build:css && yarn build:js && yarn build:extension",
    "build:css": "tailwindcss -c tailwind.config.ts -i themes/mae-storm-eats/assets/src/app.css -o themes/mae-storm-eats/assets/dist/app.css --postcss",
    "build:js": "esbuild themes/mae-storm-eats/assets/src/app.ts --bundle --format=iife --target=es2018 --sourcemap --outfile=themes/mae-storm-eats/assets/dist/app.js",
    "build:extension": "bash scripts/compile-extension.sh extension",
    "check:extension-build": "bash scripts/test/extension-build.sh",
    "commitlint": "commitlint",
    "dev": "yarn build:css --watch & yarn build:js --watch",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.tests.json"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {},
      "autoprefixer": {}
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "fluid-tailwind": "^1.0.4",
    "gsap": "^3.12.7",
    "postcss": "^8.5.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  }
}
