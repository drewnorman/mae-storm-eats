{% extends "layouts/base.twig" %}

{% block content %}
  <section class="page-shell pb-20">
    <div class="search-panel">
      <form method="get" action="{{ recipe_archive_url }}" role="search" data-recipe-filters{% if recipe_ajax_url %} data-recipe-ajax-endpoint="{{ recipe_ajax_url }}"{% endif %}>
        <div class="recipe-search">
          <label class="sr-only" for="recipe-search">Search recipes</label>
          <input id="recipe-search" class="recipe-search__input" type="search" name="s" value="{{ search_query }}" placeholder="Spicy Braised Tofu">
          <button class="recipe-search__submit" type="submit">Search</button>
        </div>

        <p class="mt-3 text-lg" data-recipe-search-summary{% if not search_query %} hidden{% endif %}>Results for “{{ search_query }}”</p>

        <div class="recipe-results-toolbar">
          <p class="recipe-results-count" data-recipe-results-count>{{ recipe_total_results }} {{ recipe_total_results == 1 ? 'recipe' : 'recipes' }}</p>
          <details class="recipe-more" data-recipe-filter-menu>
            <summary class="recipe-more__summary" aria-label="Filters, {{ recipe_filter_count }} active">
              <svg class="recipe-more__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 5h18l-7 8v5l-4 2v-7L3 5Z"/>
              </svg>
            </summary>
            <div class="recipe-more__panel">
              <div class="recipe-more__fields">
                {% for filter in recipe_filters|merge(more_recipe_filters) %}
                  <div>
                    <label class="recipe-more__label" for="recipe-more-{{ filter.parameter }}">{{ filter.label }}</label>
                    <select id="recipe-more-{{ filter.parameter }}" class="filter-select" name="{{ filter.parameter }}" data-filter-select>
                      <option value="">Any {{ filter.label|lower }}</option>
                      {% for term in filter.terms %}
                        <option value="{{ term.slug }}" {{ selected_filters[filter.parameter] == term.slug ? 'selected' : '' }}>{{ term.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                {% endfor %}
              </div>

              <div class="recipe-more__ingredients" data-ingredient-picker>
                <label class="recipe-more__label" for="ingredient-filter">Ingredients</label>
                <select id="ingredient-filter" class="recipe-more__ingredient-select" name="ingredient[]" multiple size="6" data-ingredient-select>
                  {% for term in ingredient_terms %}
                    <option value="{{ term.slug }}" {{ term.slug in selected_filters.ingredient ? 'selected' : '' }}>{{ term.name }}</option>
                  {% endfor %}
                </select>
                <div class="recipe-more__ingredient-enhancement" data-ingredient-enhancement hidden>
                  <div class="recipe-more__ingredient-entry">
                    <label class="sr-only" for="ingredient-search">Search ingredients to add</label>
                    <input id="ingredient-search" class="filter-select" type="search" list="ingredient-options" placeholder="Search ingredients" autocomplete="off" data-ingredient-search>
                    <button type="button" data-ingredient-add>Add</button>
                  </div>
                  <datalist id="ingredient-options">
                    {% for term in ingredient_terms %}<option value="{{ term.name }}"></option>{% endfor %}
                  </datalist>
                  <div class="recipe-more__ingredient-chips" data-ingredient-chips></div>
                  <p class="recipe-more__ingredient-feedback" data-ingredient-feedback aria-live="polite"></p>
                </div>
              </div>

              <fieldset class="recipe-more__match">
                <legend class="recipe-more__label">Match selected ingredients</legend>
                <label><input type="radio" name="ingredient_mode" value="any" {{ selected_filters.ingredient_mode == 'any' ? 'checked' : '' }}> Any</label>
                <label><input type="radio" name="ingredient_mode" value="all" {{ selected_filters.ingredient_mode == 'all' ? 'checked' : '' }}> All</label>
              </fieldset>
              <button class="recipe-more__apply" type="submit" data-recipe-filter-apply>Apply filters</button>
            </div>
          </details>
          <details class="recipe-sort" data-recipe-sort-menu>
            <summary class="recipe-sort__trigger" aria-label="Sort recipes. Current: {{ recipe_sort_names[recipe_sort] }}">
              <svg class="recipe-sort__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 6h12M4 11h9M4 16h6M19 7v12m0 0-3-3m3 3 3-3"/>
              </svg>
            </summary>
            <fieldset class="recipe-sort__menu">
              <legend class="sr-only">Sort recipes by</legend>
              {% for sort, label in recipe_sort_names %}
                <label class="recipe-sort__option"><input type="radio" name="sort" value="{{ sort }}" data-recipe-sort-option {% if recipe_sort == sort %}checked{% endif %}> {{ label }}</label>
              {% endfor %}
              <button class="recipe-sort__apply" type="submit" data-recipe-sort-apply>Apply sort</button>
            </fieldset>
          </details>
          <input type="hidden" name="view" value="{{ recipe_view }}" data-recipe-view-input>
          <details class="recipe-view-switch" data-recipe-view-menu>
            <summary class="recipe-view-switch__trigger" aria-label="Current view: {{ recipe_view_names[recipe_view] }}. Change recipe view">
              <span data-recipe-view-trigger-icon>
                <svg class="recipe-view-switch__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  {% if recipe_view == 'card' %}
                    <rect x="3" y="4" width="18" height="16" rx="1"/>
                    <path d="M3 14h18"/>
                  {% elseif recipe_view == 'grid' %}
                    <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                  {% else %}
                    <rect x="3" y="4" width="5" height="4" rx="1"/><path d="M11 6h10"/>
                    <rect x="3" y="10" width="5" height="4" rx="1"/><path d="M11 12h10"/>
                    <rect x="3" y="16" width="5" height="4" rx="1"/><path d="M11 18h10"/>
                  {% endif %}
                </svg>
              </span>
            </summary>
            <div class="recipe-view-switch__menu">
              {% for view, label in recipe_view_names %}
                <a class="recipe-view-switch__option" href="{{ recipe_view_links[view] }}" data-recipe-view-link="{{ view }}" {% if recipe_view == view %}aria-current="true"{% endif %}>
                  <svg class="recipe-view-switch__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    {% if view == 'card' %}
                      <rect x="3" y="4" width="18" height="16" rx="1"/>
                      <path d="M3 14h18"/>
                    {% elseif view == 'grid' %}
                      <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                      <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                    {% else %}
                      <rect x="3" y="4" width="5" height="4" rx="1"/><path d="M11 6h10"/>
                      <rect x="3" y="10" width="5" height="4" rx="1"/><path d="M11 12h10"/>
                      <rect x="3" y="16" width="5" height="4" rx="1"/><path d="M11 18h10"/>
                    {% endif %}
                  </svg>
                  {{ label }}
                  <span class="recipe-view-switch__selected" aria-hidden="true">✓</span>
                </a>
              {% endfor %}
            </div>
          </details>
        </div>
        <div class="recipe-filter-chips" role="group" aria-label="Active recipe filters" data-recipe-filter-chips {% if not recipe_filter_chips|length and not recipe_filter_selections_active %}hidden{% endif %}>
          {% for chip in recipe_filter_chips %}
            <a class="recipe-filter-chip" href="{{ chip.url }}" data-recipe-filter-chip aria-label="Remove {{ chip.label }} filter">{{ chip.label }} <span aria-hidden="true">×</span></a>
          {% endfor %}
          <a class="recipe-filters__clear" href="{{ recipe_clear_filters_url }}" data-recipe-clear-filters>Clear filters</a>
        </div>
      </form>
    </div>

    <div class="recipe-grid" data-recipe-results data-recipe-view="{{ recipe_view }}" data-recipe-page="{{ recipe_current_page }}" data-recipe-pages="{{ recipe_total_pages }}">
      {% for post in posts %}
        {% include "partials/recipe-card.twig" with { post: post } only %}
      {% else %}
        <div class="col-span-full border-2 border-dashed border-coral bg-cream p-8 text-lg">
          {{ recipe_filters_active ? 'No recipes match these filters.' : 'No recipes are ready yet.' }}
        </div>
      {% endfor %}
    </div>
    <nav class="recipe-pagination" aria-label="More recipes" data-recipe-pagination{% if not recipe_next_page_url %} hidden{% endif %}>
      <a href="{{ recipe_next_page_url ?: recipe_archive_url }}" data-recipe-next-page>Load more recipes</a>
    </nav>
    <p class="recipe-loading-status" role="status" aria-live="polite" data-recipe-loading-status></p>
    <button class="recipe-loading-retry" type="button" data-recipe-loading-retry hidden>Retry loading recipes</button>
  </section>
{% endblock %}
