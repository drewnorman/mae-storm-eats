{% extends "layouts/base.twig" %}

{% block header_leading %}
  <a class="header-back" href="{{ recipe_archive_url }}">‹ Back to Recipes</a>
{% endblock %}

{% block content %}
  <article class="page-shell pb-20">
    <header class="recipe-hero">
      <div class="min-w-0">
        {% include "partials/recipe-meta.twig" with {
          post: post,
          total_time: recipe_meta.total_time,
          recipe_yield: recipe_meta.recipe_yield
        } only %}
        <h1 class="recipe-title">{{ post.title }}</h1>
        {% set visible_terms = post.terms|filter(term => term.taxonomy not in ['recipe_ingredient', 'recipe_diet']) %}
        {% if visible_terms or recipe_meta.difficulty %}
          <p class="recipe-taxonomy">
            {% for term in visible_terms %}{{ term.name }}{% if not loop.last or recipe_meta.difficulty %}, {% endif %}{% endfor %}
            {% if recipe_meta.difficulty %}{{ recipe_meta.difficulty|capitalize }}{% endif %}
          </p>
        {% endif %}
      </div>

      {% if recipe_gallery|length == 1 and recipe_gallery[0].kind == 'image' %}
        <img class="recipe-hero__image" src="{{ recipe_gallery[0].url }}" alt="{{ recipe_gallery[0].alt }}">
      {% elseif recipe_gallery %}
        <div class="recipe-hero__gallery" data-recipe-gallery tabindex="0" role="region" aria-roledescription="carousel" aria-label="Recipe media gallery">
          <div class="recipe-hero__slides">
            {% for item in recipe_gallery %}
              <div class="recipe-hero__slide" data-recipe-gallery-slide{% if not loop.first %} hidden{% endif %}>
                {% if item.kind == 'image' %}
                  <img class="recipe-hero__media" src="{{ item.url }}" alt="{{ item.alt }}" {% if not loop.first %}loading="lazy"{% endif %}>
                {% else %}
                  <video class="recipe-hero__media" controls playsinline preload="metadata">
                    <source src="{{ item.url }}" type="{{ item.mime }}">
                    Your browser does not support this video.
                  </video>
                {% endif %}
              </div>
            {% endfor %}
          </div>
          {% if recipe_gallery|length > 1 %}
            <div class="recipe-hero__gallery-controls">
              <button type="button" data-recipe-gallery-previous aria-label="Previous gallery item">‹</button>
              <span data-recipe-gallery-position aria-live="polite">1 / {{ recipe_gallery|length }}</span>
              <button type="button" data-recipe-gallery-next aria-label="Next gallery item">›</button>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </header>

    <div class="recipe-surface">
      <div class="recipe-body">
        {% if recipe_data.ingredients %}
          <section class="ingredients-panel">
            <h2 class="recipe-section-title">Ingredients</h2>
            <ul class="mt-3 list-disc space-y-1 pl-5 font-montserrat text-sm leading-6 text-neutral-900">
              {% for ingredient in recipe_data.ingredients %}
                <li>{{ ingredient|raw }}</li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        <section class="directions-panel">
          <h2 class="recipe-section-title">Directions</h2>
          {% if recipe_data.steps %}
            <ol class="mt-4 list-decimal space-y-2 pl-6 font-montserrat text-sm leading-7 text-neutral-900">
              {% for step in recipe_data.steps %}
                <li class="pl-2">{{ step|raw }}</li>
              {% endfor %}
            </ol>
          {% else %}
            <div class="prose mt-4 max-w-none font-montserrat text-neutral-900">{{ post.content }}</div>
          {% endif %}
        </section>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap gap-3 text-sm print:hidden">
      <a class="secondary-action" href="{{ post.link }}?print=1">Print</a>
      <a class="secondary-action" href="{{ post.link }}?share=1">Share</a>
    </div>

    {% if related_recipes %}
      <section class="mt-12" aria-labelledby="related-recipes-heading">
        <h2 id="related-recipes-heading" class="section-heading">Related…</h2>
        <div class="recipe-grid mt-6">
          {% for post in related_recipes %}
            {% include "partials/recipe-card.twig" with { post: post } only %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if recipe_reviews %}
      <section class="reviews-panel">
        <h2 class="section-heading">Reviews <span class="font-normal">({{ recipe_reviews|length }})</span></h2>
        <div class="mt-7 grid gap-5">
          {% for review in recipe_reviews %}
            <article class="review">
              <div class="flex flex-wrap justify-center gap-x-3 gap-y-1 text-sm font-bold uppercase">
                {% if review.author %}<span>{{ review.author }}</span>{% endif %}
                {% if review.reviewed_at %}<time>{{ review.reviewed_at }}</time>{% endif %}
                {% if review.pinterest_url %}<a class="text-plum underline hover:text-olive" href="{{ review.pinterest_url }}" rel="noreferrer">Pinterest</a>{% endif %}
              </div>
              <div class="prose mx-auto mt-3 max-w-4xl text-center font-montserrat text-olive">{{ review.body|raw }}</div>
              {% if review.photos %}
                <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
                  {% for photo in review.photos %}<img class="aspect-square w-full object-cover" src="{{ photo.src('large') }}" alt="{{ photo.alt }}">{% endfor %}
                </div>
              {% endif %}
              {% if review.media_incomplete %}<p class="mt-3 text-sm text-red-800">Some Pinterest photos could not be imported.</p>{% endif %}
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if recipe_schema %}<script type="application/ld+json">{{ recipe_schema|raw }}</script>{% endif %}
  </article>
{% endblock %}
