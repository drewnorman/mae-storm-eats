<!doctype html>
<html class="min-h-full bg-stone-50 text-slate-950" {{ function('language_attributes') }}>
  <head>
    <meta charset="{{ site.charset }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ function('wp_head') }}
  </head>
  <body class="{{ body_class }} min-h-full antialiased">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:shadow" href="#content">
      Skip to content
    </a>

    <div class="min-h-screen bg-[linear-gradient(180deg,#fafaf9_0%,#f8fafc_58%,#fff7ed_100%)]">
      <header class="border-b border-slate-200/80 bg-white/90 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
          <a class="text-base font-semibold tracking-normal text-slate-950" href="{{ site.url }}">
            {{ site_name|default(site.name) }}
          </a>

          <nav class="flex items-center gap-3 text-sm text-slate-700" aria-label="Primary">
            <a class="rounded-md px-2 py-1 hover:bg-slate-100 hover:text-slate-950" href="{{ site.url }}">Recipes</a>
            <a class="rounded-md px-2 py-1 hover:bg-slate-100 hover:text-slate-950" href="{{ site.url }}/?s=">Search</a>
          </nav>
        </div>
      </header>

      <main id="content" data-recipe-shell>
        {% block content %}{% endblock %}
      </main>
    </div>

    {{ function('wp_footer') }}
  </body>
</html>
