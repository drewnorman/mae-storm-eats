{% extends "layouts/base.twig" %}

{% block content %}
  <article class="mx-auto max-w-3xl px-4 py-8 print:max-w-none print:px-0">
    <header class="flex flex-col gap-4 border-b border-slate-200 pb-5 print:border-slate-400">
      <div>
        <p class="text-sm font-medium text-amber-700 print:hidden">Recipe copy</p>
        <h1 class="mt-2 text-3xl font-semibold text-slate-950">{{ post.title }}</h1>
      </div>

      <div class="flex gap-2 print:hidden">
        <button class="rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" type="button" data-print-recipe>Print</button>
        <a class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-amber-300" href="{{ post.link }}">Back</a>
      </div>
    </header>

    <div class="prose prose-slate mt-8 max-w-none print:prose-sm">
      {{ post.content }}
    </div>
  </article>
{% endblock %}
