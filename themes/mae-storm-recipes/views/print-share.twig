{% extends "layouts/base.twig" %}

{% block content %}
  <article class="mx-auto max-w-4xl px-4 py-8 print:max-w-none print:px-0 print:text-black">
    <header class="flex flex-col gap-5 border-b-2 border-coral pb-6 print:border-black">
      <div>
        <p class="text-sm font-bold uppercase text-plum print:hidden">Recipe copy</p>
        <h1 class="mt-2 text-4xl text-olive print:text-black">{{ post.title }}</h1>
      </div>
      <div class="flex gap-3 print:hidden">
        <button class="bg-olive px-5 py-3 text-white hover:bg-plum" type="button" data-print-recipe>Print</button>
        <a class="secondary-action" href="{{ post.link }}">Back</a>
      </div>
    </header>

    <div class="prose mt-8 max-w-none font-montserrat print:prose-sm">{{ post.content }}</div>

    {% if recipe_data.ingredients %}
      <h2 class="mt-8 text-2xl font-bold uppercase text-plum print:text-black">Ingredients</h2>
      <ul class="mt-3 list-disc space-y-1 pl-6 font-montserrat">
        {% for ingredient in recipe_data.ingredients %}<li>{{ ingredient|raw }}</li>{% endfor %}
      </ul>
    {% endif %}

    {% if recipe_data.steps %}
      <h2 class="mt-8 text-2xl font-bold uppercase text-plum print:text-black">Steps</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-6 font-montserrat">
        {% for step in recipe_data.steps %}<li>{{ step|raw }}</li>{% endfor %}
      </ol>
    {% endif %}
  </article>
{% endblock %}
