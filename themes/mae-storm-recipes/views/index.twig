{% extends "layouts/base.twig" %}

{% block content %}
  <section class="mx-auto grid max-w-6xl gap-6 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <div>
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-medium text-amber-700">Private kitchen archive</p>
          <h1 class="mt-1 text-3xl font-semibold text-slate-950">Recipes</h1>
        </div>

        <form class="flex max-w-md gap-2" role="search" method="get" action="{{ site.url }}">
          <label class="sr-only" for="recipe-search">Search recipes</label>
          <input id="recipe-search" class="min-w-0 flex-1 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-200" type="search" name="s" value="{{ recipe_query }}" placeholder="Search recipes">
          <button class="rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" type="submit">Search</button>
        </form>
      </div>

      <div class="grid gap-3 @container">
        {% for post in posts %}
          <article class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition hover:border-amber-300">
            <a class="block" href="{{ post.link }}">
              <h2 class="text-lg font-semibold text-slate-950">{{ post.title }}</h2>
              {% if post.preview %}
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{{ post.preview.read_more(false) }}</p>
              {% endif %}
            </a>
          </article>
        {% else %}
          <div class="rounded-lg border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-600">
            No recipes are ready yet.
          </div>
        {% endfor %}
      </div>
    </div>

    <aside class="h-fit rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-950">Filters</h2>
      <div class="mt-4 grid gap-2 text-sm text-slate-600">
        <button class="rounded-md border border-slate-200 px-3 py-2 text-left hover:border-amber-300 hover:bg-amber-50" type="button">Course</button>
        <button class="rounded-md border border-slate-200 px-3 py-2 text-left hover:border-amber-300 hover:bg-amber-50" type="button">Cuisine</button>
        <button class="rounded-md border border-slate-200 px-3 py-2 text-left hover:border-amber-300 hover:bg-amber-50" type="button">Diet</button>
      </div>
    </aside>
  </section>
{% endblock %}
